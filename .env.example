# Explicit model-less demo. Never executes generated shell commands.
CHESTNUT_MODE=demo
CHESTNUT_DATA_DIR=.chestnut
CHESTNUT_HOST=127.0.0.1
CHESTNUT_PORT=4310

# Real Pi: use a DIFFERENT, short, private data directory on Linux.
# CHESTNUT_MODE=pi
# CHESTNUT_DATA_DIR=/home/you/chestnut-pi
# CHESTNUT_MODEL=gpt-4o-mini
# CHESTNUT_IMAGE=chestnut-pi:4270522473e6
# Set OPENAI_API_KEY in the outer worker environment or your secret manager.
# Do not paste credentials into chat, task prompts, workspaces, or source files.

# Experimental persistent writable rootfs (new data directory required):
# CHESTNUT_SANDBOX_PROFILE=persistent
# CHESTNUT_EXPERIMENTAL_PERSISTENT=1
# CHESTNUT_NETWORK_POLICY=none
# Whole-bot stop at every task boundary preserves files, interrupts services.
# Maintenance/online-install networking is intentionally unavailable.

# Sourced long-term memory maintenance in the outer worker.
# Demo learns explicit Remember:/记住： requests; Pi uses its existing credential.
CHESTNUT_MEMORY_AUTOMATIC=1
CHESTNUT_MEMORY_DAILY_CALLS=24
