# Explicit model-less demo. Never executes generated shell commands.
CHESTNUT_MODE=demo
CHESTNUT_DATA_DIR=.chestnut
CHESTNUT_HOST=127.0.0.1
CHESTNUT_PORT=4310

# Real Pi: use a DIFFERENT, short, private data directory on Linux.
# CHESTNUT_MODE=pi
# CHESTNUT_DATA_DIR=/home/you/chestnut-pi
# CHESTNUT_MODEL=gpt-4o-mini
# CHESTNUT_IMAGE=chestnut-pi:4270522473e6
# Set OPENAI_API_KEY in the outer worker environment or your secret manager.
# Do not paste credentials into chat, task prompts, workspaces, or source files.

# Experimental persistent writable rootfs (new data directory required):
# CHESTNUT_SANDBOX_PROFILE=persistent
# CHESTNUT_EXPERIMENTAL_PERSISTENT=1
# CHESTNUT_NETWORK_POLICY=none
# Whole-bot stop at every task boundary preserves files, interrupts services.
# Maintenance/online-install networking is intentionally unavailable.

# Sourced long-term memory maintenance in the outer worker.
# Demo learns explicit Remember:/记住： requests; Pi uses its existing credential.
CHESTNUT_MEMORY_AUTOMATIC=1
CHESTNUT_MEMORY_DAILY_CALLS=24

# New service profile: writable Bot root + disposable Pi runner (new directory).
# CHESTNUT_SANDBOX_PROFILE=service
# CHESTNUT_EXPERIMENTAL_SERVICE=1
# CHESTNUT_DATA_DIR=/home/you/chestnut-service
# CHESTNUT_NETWORK_POLICY=none
# Exact package/dependency and HTTPS-host allowlists are edited in Environment UI.
# Success may preserve services; cancel/crash/uncertainty stops the entire Bot.

# Optional owner-only Telegram channel. Put token in a secure outer environment.
# CHESTNUT_TELEGRAM_ENABLED=1
# CHESTNUT_TELEGRAM_BOT_TOKEN=<securely supplied, never commit>
# CHESTNUT_TELEGRAM_OWNER_ID=<numeric owner id>
# CHESTNUT_TELEGRAM_CHAT_ID=<numeric private chat id>
# CHESTNUT_TELEGRAM_BOT_ID=<existing Chestnut bot UUID>

# Optional offline Chromium desktop, only with explicit Pi service profile.
# Build the desktop image as documented in docs/desktop-snapshots.md first.
# CHESTNUT_DESKTOP_ENABLED=1
# CHESTNUT_IMAGE=chestnut-pi-desktop:4270522473e6
# Browser sandbox stays enabled; do not expose VNC/CDP/control ports.
